rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Un utilisateur ne lit/écrit que ses propres diagnostics.
    match /users/{userId}/diagnoses/{diagnosisId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, update: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Points de vente : lecture publique (utile à tous les agriculteurs),
    // écriture réservée à un rôle "admin" géré côté back-office.
    match /points_de_vente/{vendorId} {
      allow read: if true;
      allow write: if false; // à gérer via la console / un script admin
    }

    // Fil communautaire : un utilisateur connecté peut publier un
    // signalement, tout le monde connecté peut les lire. On ne peut
    // modifier/supprimer que son propre signalement.
    match /signalements/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Marketplace : même logique que les signalements.
    match /marketplace/{listingId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.sellerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.sellerId == request.auth.uid;
    }

    // Par défaut : tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
